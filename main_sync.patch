-    schema = dict(schema)
-    if "type" in schema:
-        schema["type"] = BFCL_TO_JSON_TYPE.get(schema["type"], schema["type"])
-    if "properties" in schema:
-        schema["properties"] = {k: _to_json_schema(v) for k, v in schema["properties"].items()}
-    if "items" in schema:
-        schema["items"] = _to_json_schema(schema["items"])
